# Optional: combined private key + certificate PEM for HTTPS dev server.
# MTREK_CERT=/path/to/cert.pem

# Optional: Vite HMR websocket endpoint when using a reverse proxy or custom host.
# MTREK_HMR_HOST=vite.roxen.com
# MTREK_HMR_PORT=5174
# MTREK_HMR_PROTOCOL=wss
# MTREK_HMR_CLIENT_PORT=5174

# Local development PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mtrek
# Optional: cap database pool size. Defaults to 10 locally and 1 on Vercel.
# DATABASE_POOL_MAX=10

# Optional hosted PostgreSQL variables. Vercel/Supabase integrations may provide
# these instead of DATABASE_URL. Runtime uses DATABASE_URL first, then POSTGRES_URL,
# POSTGRES_PRISMA_URL, then POSTGRES_URL_NON_POOLING.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Optional: override the URL used by drizzle-kit commands. For Supabase, prefer
# the non-pooling URL for schema pushes and migrations.
# DRIZZLE_DATABASE_URL=

# Optional Supabase API variables. Not used for Drizzle/Auth.js database access.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true

# OAuth sign-in providers. Configure either or both.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Optional Spotify album search. Falls back to AUTH_SPOTIFY_* if omitted.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
